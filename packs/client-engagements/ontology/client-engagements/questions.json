{
  "_about": "What a graph in this vocabulary must answer; a term no question cites has no reason to exist.",
  "questions": {
    "CE1": {
      "who": "a partner",
      "question": "Which opportunities are we pursuing with client $CLIENT, at what stage, and who is leading each?",
      "why": "Pipeline reviews start here, and today the answer sits in several people's heads.",
      "validated_by": "Scott Ivory, 2026-11-03",
      "params": {
        "CLIENT": {
          "type": "Organization"
        }
      },
      "ask": {
        "when": [
          {
            "edge": [
              "$CLIENT",
              "client_of",
              "p"
            ]
          },
          {
            "node": "p",
            "type": "Pursuit"
          },
          {
            "edge": [
              "lead",
              "owns",
              "p"
            ]
          }
        ],
        "select": [
          "p.label",
          "p.stage",
          "p.estimated_value_cad",
          "p.expected_close",
          "lead.label"
        ]
      },
      "gate": "any"
    },
    "CE2": {
      "who": "a practitioner",
      "question": "Which solution documents have we written for work on platform $PLATFORM, and for which pursuit or engagement?",
      "why": "Finding a reusable solution is the most painful search today.",
