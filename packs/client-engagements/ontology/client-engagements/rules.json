{
  "_about": "What this pack derives and what its policy flags. Never fill validated_by yourself.",
  "rules": [
    {
      "id": "actual-assignment-is-experience",
      "kind": "derive",
      "when": [
        {
          "node": "a",
          "type": "Assignment",
          "where": {
            "kind": "actual"
          }
        },
        {
          "edge": [
            "a",
            "assignee",
            "p"
          ]
        },
        {
          "edge": [
            "a",
            "staffs",
            "eng"
          ]
        },
        {
          "node": "eng",
          "type": "Engagement"
        }
      ],
      "then": {
        "edge": [
          "p",
          "worked_on",
          "eng"
        ]
      },
      "why": "Experience questions need person-to-engagement; documents record assignments, and nobody should maintain a skills list by hand.",
      "validated_by": "Scott Ivory, 2026-11-03"
    },
    {
      "id": "price-has-a-band",
      "kind": "policy",
      "severity": "warn",
      "answers": "CE9",
      "when": [
        {
          "node": "pm",
          "type": "PricingModel"
        },
        {
          "not_edge": [
            "pm",
            "held_to",
            "*"
          ]
        }
      ],
      "then": {
        "flag": "a price is not held to a margin band: nobody can say whether it needed an exception"
      },
      "why": "Margin approval is judged against the band in force when the price was set.",
      "validated_by": "Scott Ivory, 2026-11-03"
    },
    {
      "id": "commitment-overdue",
      "kind": "policy",
      "severity": "warn",
      "answers": "CE18",
      "when": [
        {
          "node": "c",
          "type": "Commitment",
          "where": {
            "state": "open",
            "due_on": {
              "<": "$today"
            }
          }
        }
      ],
      "then": {
        "flag": "a commitment is past its due date and still open: chase it, or record it as missed or waived"
      },
      "why": "A late client dependency left open hides the reason a date slipped.",
      "validated_by": "Scott Ivory, 2026-11-03"
    }
  ]
}
