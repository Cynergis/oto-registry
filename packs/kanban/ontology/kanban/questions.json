{
  "_about": "What a graph in this vocabulary must answer; a term no question cites has no reason to exist. Each question runs over the graph in the pattern language of rules.json; counting and durations are worked out from the rows it returns.",
  "questions": {
    "KB1": {
      "who": "a team lead",
      "question": "Which columns on $BOARD are over their work-in-progress limit right now, and by how many cards?",
      "why": "A column over its limit is where the team has started more than it can finish; the limit only works if someone sees it broken. Answering: Count the cards per column and compare with its limit.",
      "validated_by": "Chiheb Dkhil, 2026-11-02 (walked through in the ontology interview)",
      "params": {
        "BOARD": {
          "type": "Board"
        }
      },
      "ask": {
        "when": [
          {
            "edge": [
              "k",
              "column_of",
              "$BOARD"
            ]
          },
          {
            "node": "k",
            "type": "Column"
          },
          {
            "edge": [
              "l",
              "limits",
              "k"
            ]
          },
          {
            "node": "l",
            "type": "WipLimit"
          },
          {
            "not": [
              {
                "edge": [
                  "l_later",
                  "limits",
                  "k"
                ]
              },
              {
                "node": "l_later",
                "type": "WipLimit",
                "where": {
                  "set_on": {
                    ">": "$l.set_on"
                  }
                }
              }
            ]
          },
          {
            "optional": [
              {
                "edge": [
                  "m",
                  "move_of",
                  "c"
                ]
              },
              {
                "node": "m",
                "type": "Move"
              },
              {
                "edge": [
                  "m",
                  "into",
                  "k"
                ]
              },
              {
                "not": [
                  {
                    "edge": [
                      "m_later",
                      "move_of",
                      "c"
                    ]
                  },
                  {
                    "node": "m_later",
                    "type": "Move",
                    "where": {
                      "moved_on": {
                        ">": "$m.moved_on"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ],
        "select": [
          "k.label",
          "l.max_cards",
          "c.label"
        ]
      },
      "gate": "any",
      "gaps": {
        "when": [
          {
            "node": "$BOARD",
            "type": "Board"
          }
        ],
        "say": "no column on this board has a limit"
      }
    },
